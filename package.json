{
  "name": "@leow3lab/leow3bot",
  "version": "0.1.0",
  "description": "leow3bot — CLI AI agent (TypeScript + ink)",
  "type": "module",
  "bin": {
    "leow3bot": "./dist/main.mjs"
  },
  "homepage": "https://leow3bot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuanhechen/leow3bot.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.tsx",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "probe": "tsx src/scripts/probe.ts",
    "typecheck": "tsc --noEmit",
    "test:md": "FORCE_COLOR=1 tsx src/scripts/test-markdown.tsx",
    "test:app": "FORCE_COLOR=1 tsx src/scripts/test-app.tsx",
    "test:store": "tsx src/scripts/test-store.ts",
    "test:perm": "tsx src/scripts/test-permissions.ts",
    "test": "tsc --noEmit && npm run test:md && npm run test:store && npm run test:perm && npm run test:app"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.50.1",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "sharp": "^0.33.5",
    "strip-ansi": "^7.2.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/react": "^18.3.31",
    "@types/turndown": "^5.0.6",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  },
  "license": "Apache-2.0",
  "keywords": [
    "cli",
    "ai-agent",
    "terminal",
    "tui",
    "ink",
    "react",
    "glm",
    "zhipu",
    "bigmodel",
    "anthropic",
    "chatbot",
    "coding-assistant"
  ]
}
